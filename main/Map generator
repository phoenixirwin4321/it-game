def terrain():
    create_map_def(SIZE)
    for i in range(LAND):
    
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
        display.fill((255,255,255))
        create_map()
        render_map()
        print_map()
        pygame.display.flip()
        subprocess.run('cls' if os.name == "nt" else "clear", shell=True)
    clear_outliers()
    display.fill((255,255,255))
    render_map()
    pygame.display.flip()
terrain()
